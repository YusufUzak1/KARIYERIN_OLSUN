# ============================================
# Docker Ignore - Gereksiz dosyaları hariç tut
# ============================================

# Git
.git
.gitignore

# Python cache
__pycache__
*.py[cod]
*$py.class
*.so
.Python

# Virtual environment
venv/
env/
.venv/
.env

# IDE
.vscode/
.idea/
*.swp
*.swo

# Test & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# Build
*.egg-info/
dist/
build/

# Logs
*.log
logs/

# Local config
.env.local
.env.example

# Documentation
README.md
docs/

# Docker files (recursive önleme)
Dockerfile*
docker-compose*
.dockerignore

# DeepFace cache (biz build time'da indireceğiz)
.deepface/
